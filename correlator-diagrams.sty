\newcommand{\corr@drawsunsetmomentumline}[7]{%
  \edef\corr@thismomarrowsize{\corr@momentumarrowsizefor{#1}}%
  \draw[-{Stealth[length=\corr@thismomarrowsize]},line width=0.8pt]
