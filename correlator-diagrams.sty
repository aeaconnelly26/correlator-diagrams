\newcommand{\corr@ifstringeq}[4]{%
  \edef\corr@stringtmpa{#1}%
  \def\corr@stringtmpb{#2}%
  \ifx\corr@stringtmpa\corr@stringtmpb
    #3%
  \else
    #4%
  \fi
}

\newcommand{\corr@ifexternallegs}[1]{%
