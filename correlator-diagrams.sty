\newcommand{\corr@configurestyles}{%
  \ifstrequal{\corr@scalararrowdirection}{out}{%
    \tikzfeynhandset{
      every scalar polarized@@/.style={
        /tikzfeynhand/every scalar polarized base@@,
        /tikz/postaction={/tikzfeynhand/with reversed open arrow=\corr@scalararrowposition},
      },
    }%
  }{%
    \ifstrequal{\corr@scalararrowdirection}{none}{%
      \tikzfeynhandset{
        every scalar polarized@@/.style={
          /tikzfeynhand/every scalar polarized base@@,
        },
      }%
    }{%
      \tikzfeynhandset{
        every scalar polarized@@/.style={
          /tikzfeynhand/every scalar polarized base@@,
          /tikz/postaction={/tikzfeynhand/with open arrow=\corr@scalararrowposition},
        },
      }%
    }%
  }%
  \ifstrequal{\corr@antiscalararrowdirection}{out}{%
    \tikzfeynhandset{
      every anti scalar polarized@@/.style={
        /tikzfeynhand/every scalar polarized base@@,
        /tikz/postaction={/tikzfeynhand/with reversed open arrow=\corr@antiscalararrowposition},
      },
    }%
  }{%
    \ifstrequal{\corr@antiscalararrowdirection}{none}{%
      \tikzfeynhandset{
        every anti scalar polarized@@/.style={
          /tikzfeynhand/every scalar polarized base@@,
        },
      }%
    }{%
      \tikzfeynhandset{
        every anti scalar polarized@@/.style={
          /tikzfeynhand/every scalar polarized base@@,
          /tikz/postaction={/tikzfeynhand/with open arrow=\corr@antiscalararrowposition},
        },
      }%
    }%
  }%
  \tikzfeynhandset{
    every scalar polarized/.style={/tikzfeynhand/every scalar polarized@@/.append style={##1}},
    scalar polarized/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every scalar polarized@@,
    },
    scalarpolarized/.style={/tikzfeynhand/scalar polarized},
    scalar polarized inward/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every scalar polarized base@@,
      /tikz/postaction={/tikzfeynhand/with open arrow=\corr@scalararrowposition},
    },
    scalar polarized outward/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every scalar polarized base@@,
      /tikz/postaction={/tikzfeynhand/with reversed open arrow=\corr@scalararrowposition},
    },
    scalarpolarizedin/.style={/tikzfeynhand/scalar polarized inward},
    scalarpolarizedout/.style={/tikzfeynhand/scalar polarized outward},
    spolin/.style={/tikzfeynhand/scalar polarized inward},
    spolout/.style={/tikzfeynhand/scalar polarized outward},
    every anti scalar polarized/.style={/tikzfeynhand/every anti scalar polarized@@/.append style={##1}},
    anti scalar polarized/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every anti scalar polarized@@,
    },
    antiscalarpolarized/.style={/tikzfeynhand/anti scalar polarized},
    anti scalar polarized inward/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every scalar polarized base@@,
      /tikz/postaction={/tikzfeynhand/with open arrow=\corr@antiscalararrowposition},
    },
    anti scalar polarized outward/.style={
      /tikzfeynhand/scalar,
      /tikzfeynhand/every scalar polarized base@@,
      /tikz/postaction={/tikzfeynhand/with reversed open arrow=\corr@antiscalararrowposition},
    },
    antiscalarpolarizedin/.style={/tikzfeynhand/anti scalar polarized inward},
    antiscalarpolarizedout/.style={/tikzfeynhand/anti scalar polarized outward},
    spol/.style={/tikzfeynhand/scalar polarized},
    antspol/.style={/tikzfeynhand/anti scalar polarized},
    antspolin/.style={/tikzfeynhand/anti scalar polarized inward},
    antspolout/.style={/tikzfeynhand/anti scalar polarized outward},
  }%
}

