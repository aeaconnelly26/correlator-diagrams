\newcommand{\corr@wcirc}{%
  \ensuremath{\scriptstyle W}%
}

\newcommand{\corr@chargedwcirc}[1]{%
  \ensuremath{\scriptstyle W^{\mkern-2mu\raisebox{0.08ex}{\scalebox{0.68}{\ensuremath{\scriptscriptstyle #1}}}}}%
}

\newcommand{\corr@circlabel}[1]{%
  \def\corr@circlabelraw{#1}%
  \def\corr@circlabelw{W}%
  \def\corr@circlabelwp{Wp}%
  \def\corr@circlabelwm{Wm}%
  \ifx\corr@circlabelraw\corr@circlabelw
    \corr@wcirc
  \else
    \ifx\corr@circlabelraw\corr@circlabelwp
      \corr@chargedwcirc{+}%
    \else
      \ifx\corr@circlabelraw\corr@circlabelwm
        \corr@chargedwcirc{-}%
      \else
        \ensuremath{\scriptstyle #1}%
      \fi
    \fi
  \fi
}

\tikzfeynhandset{
  circ position/.initial=0.5,
  circ size/.initial=12pt,
  circ fill/.initial=white,
  circ draw/.initial=black,
  every circ label@@/.style={},
  circ label style/.style={/tikzfeynhand/every circ label@@/.style={#1}},
  with circ/.style={
    /tikz/decoration={
      markings,
      mark=at position \pgfkeysvalueof{/tikzfeynhand/circ position} with {
        \node[
          circle,
          draw=\pgfkeysvalueof{/tikzfeynhand/circ draw},
          fill=\pgfkeysvalueof{/tikzfeynhand/circ fill},
          line width=0.7\feynhandlinesize,
          inner sep=0pt,
          minimum size=\pgfkeysvalueof{/tikzfeynhand/circ size},
          outer sep=0pt
        ] {};
        \node[
          anchor=center,
          inner sep=0pt,
          outer sep=0pt,
          /tikzfeynhand/every circ label@@
        ] {\corr@circlabel{#1}};
      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
  circ/.style={/tikzfeynhand/with circ={#1}},
  with circle/.style={/tikzfeynhand/circ={#1}},
  circled/.style={/tikzfeynhand/circ={#1}},
  with open arrow/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \node[
          transform shape,
          xshift=-0.08\feynhandarrowsize,
          fill opacity=0,
          draw,
          line width=0.7\feynhandlinesize,
          inner sep=0mm,
          minimum size=\tikzfeynhand@arrow@size,
          regular polygon,
          regular polygon sides=3,
          shape border rotate=-90
        ] { };
      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
  with reversed open arrow/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \node[
          transform shape,
          xshift=0.08\feynhandarrowsize,
          rotate=180,
