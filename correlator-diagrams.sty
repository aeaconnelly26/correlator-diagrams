\tikzfeynhandset{
  with open arrow/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \node[
          transform shape,
          xshift=-0.166666\feynhandarrowsize,
          fill opacity=0,
          draw,
          line width=0.7\feynhandlinesize,
          inner sep=0mm,
          minimum width=\tikzfeynhand@arrow@size,
          isosceles triangle
        ] { };
      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
  with reversed open arrow/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \node[
          transform shape,
          xshift=0.166666\feynhandarrowsize,
          rotate=180,
          fill opacity=0,
          draw,
          line width=0.7\feynhandlinesize,
          inner sep=0mm,
          minimum width=\tikzfeynhand@arrow@size,
          isosceles triangle
        ] { };
      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
  every scalar polarized base@@/.style={
    /tikz/draw=none,
    /tikz/decoration={name=none},
  },
}

