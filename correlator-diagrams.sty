\newcommand{\corr@resolvemomentumlabelplacement}[4]{%
  \corr@resolvesunsetindexanchor{#1}%
  \edef\corr@momentumlabelanchor{\corr@sunsetresolvedanchor}%
  \edef\corr@momentumlabelxshift{#3}%
  \edef\corr@momentumlabelyshift{#4}%
  \corr@ifstringeq{#1}{above}{%
    \edef\corr@momentumlabelyshift{\the\dimexpr #4 + #2\relax}%
  }{}%
  \corr@ifstringeq{#1}{below}{%
    \edef\corr@momentumlabelyshift{\the\dimexpr #4 - #2\relax}%
  }{}%
  \corr@ifstringeq{#1}{left}{%
    \edef\corr@momentumlabelxshift{\the\dimexpr #3 - #2\relax}%
  }{}%
  \corr@ifstringeq{#1}{right}{%
    \edef\corr@momentumlabelxshift{\the\dimexpr #3 + #2\relax}%
  }{}%
}

\newcommand{\corr@putmomentumlabelwithdistance}[6]{%
  \corr@resolvemomentumlabelplacement{#2}{#3}{#4}{#5}%
  \node[
    anchor=\corr@momentumlabelanchor,
    xshift=\corr@momentumlabelxshift,
    yshift=\corr@momentumlabelyshift,
    fill=\corr@momentumlabelfill,
    inner sep=\corr@momentumlabelinnersep,
    outer sep=0pt,
    \corr@momentumlabelstyle
  ] at #1 {\hbox{\corr@momentumlabelsize $#6$}};
}

\newcommand{\corr@drawmomentumrangein}[7]{%
  \edef\corr@thismomarrowsize{\corr@momentumarrowsizefor{#1}}%
  \def\corr@currentmomentumshortenstart{0pt}%
  \def\corr@currentmomentumshortenend{0pt}%
  \pgfmathsetmacro{\corr@externalmomgapstart}{max(#5,#7-\corr@momentumlabelgap)}%
  \pgfmathsetmacro{\corr@externalmomgapend}{min(#6,#7+\corr@momentumlabelgap)}%
  \path
    ($(#2)!#7!(#3)!6pt!#4:(#3)$)
    coordinate (corrmomentumlabelcoord);
  \draw[line width=\corr@momentumlinewidth]
    ($(#2)!#5!(#3)!6pt!#4:(#3)$) --
    ($(#2)!\corr@externalmomgapstart!(#3)!6pt!#4:(#3)$);
  \draw[-{Stealth[length=\corr@thismomarrowsize]},line width=\corr@momentumlinewidth]
    ($(#2)!\corr@externalmomgapend!(#3)!6pt!#4:(#3)$) --
    ($(#2)!#6!(#3)!6pt!#4:(#3)$);
  \corr@putmomentumlabelat
    {(corrmomentumlabelcoord)}
    {center}
    {0pt}
    {0pt}
    {\corr@momentumlabel{#1}}%
}

