\NewDocumentCommand{\ThreePointCorr}{O{}}{%
  \begingroup
  \corr@resetthreepointdefaults
  \pgfqkeys{/corrdiag}{#1}%
  \corr@preparelists
  \corr@configurestyles
  \begin{tikzpicture}[baseline=-0.6ex,scale=\corr@scale]
    \begin{feynhand}
      \corr@topologycoordinate{corrC}{0}{0}%
      \corr@topologycoordinate{corrUL}{-\corr@threepointleftxspan}{\corr@threepointupperyspan}%
      \corr@topologycoordinate{corrR}{\corr@threepointrightxspan}{0}%
      \corr@topologycoordinate{corrB}{0}{-\corr@threepointbottomyspan}%
      \corr@ifexternallegs{%
        \corr@topologydrawprop{mom}{1}{corrUL}{corrC}%
        \corr@topologydrawprop{mom'}{2}{corrR}{corrC}%
        \corr@topologydrawprop{mom'}{3}{corrB}{corrC}%
      }%
      \ifcorr@blob
        \corr@putblob{corrC}{\corr@blobstyle}
      \fi
    \end{feynhand}
    \ifcorr@centervertex
      \corr@putvertex{corrC}{\corr@centervertexstyle}
    \fi
    \corr@threepointplaceexternalvertices
    \ifcorr@showmomenta
      \corr@drawthreepointmomentumul{1}{corrUL}{corrC}
      \corr@drawthreepointmomentumr{2}{corrR}{corrC}
      \corr@drawthreepointmomentumb{3}{corrB}{corrC}
    \fi
    \corr@threepointplaceexternallabels
    \corr@putthreepointcentral{corrC}
  \end{tikzpicture}%
  \endgroup
}

\NewDocumentCommand{\TwoPointCorr}{O{}}{%
  \begingroup
  \pgfqkeys{/corrdiag}{#1}%
  \corr@preparelists
  \corr@configurestyles
  \begin{tikzpicture}[baseline=-0.6ex,scale=\corr@scale]
    \begin{feynhand}
      \vertex (corrC) at (0,0);
      \vertex (corrL) at (-1.85,0);
      \vertex (corrR) at (1.85,0);
      \corr@ifexternallegs{%
        \corr@drawprop{mom}{1}{corrL}{corrC}%
        \corr@drawprop{mom'}{2}{corrR}{corrC}%
      }%
      \ifcorr@blob
        \corr@putblob{corrC}{\corr@blobstyle}
      \fi
    \end{feynhand}
    \ifcorr@centervertex
      \corr@putvertex{corrC}{\corr@centervertexstyle}
    \fi
    \corr@ifshowexternalvertices{%
      \corr@putvertex{corrL}{\corr@externalvertexstyle}
      \corr@putvertex{corrR}{\corr@externalvertexstyle}
    }%
    \ifcorr@showmomenta
      \corr@drawmomentum{1}{corrL}{corrC}{90}
      \corr@drawmomentum{2}{corrR}{corrC}{-90}
    \fi
    \corr@putlabel{corrL}{xshift=-10pt}{1}
    \corr@putlabel{corrR}{xshift=10pt}{2}
    \corr@putcentral{corrC}
  \end{tikzpicture}%
  \endgroup
}

