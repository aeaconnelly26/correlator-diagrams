\newcommand{\corr@setsunsettriplet}[2]{%
  \expandafter\def\csname corr@sunset#1leftindex\endcsname{}%
  \expandafter\def\csname corr@sunset#1propindex\endcsname{}%
  \expandafter\def\csname corr@sunset#1rightindex\endcsname{}%
  \readlist*\corr@sunsettriplettmp{#2}%
  \ifnum\corr@sunsettriplettmplen>0
    \expandafter\def\csname corr@sunset#1leftindex\endcsname{\corr@sunsettriplettmp[1]}%
  \fi
  \ifnum\corr@sunsettriplettmplen>1
    \expandafter\def\csname corr@sunset#1propindex\endcsname{\corr@sunsettriplettmp[2]}%
  \fi
  \ifnum\corr@sunsettriplettmplen>2
    \expandafter\def\csname corr@sunset#1rightindex\endcsname{\corr@sunsettriplettmp[3]}%
  \fi
}

