\newcommand{\corr@indexsuffix}[1]{%
  \corr@ifstringeq{\corr@indexplacement}{sup}{^{#1}}{%
    \corr@ifstringeq{\corr@indexplacement}{none}{#1}{_{#1}}%
  }%
}

\newcommand{\corr@fieldwithindex}[1]{%
  \ifnum\corr@indexitemslen<#1
    \corr@field
  \else
    \ifdefempty{\corr@field}{%
      \corr@indexitems[#1]%
    }{%
      \corr@field\corr@indexsuffix{\corr@indexitems[#1]}%
