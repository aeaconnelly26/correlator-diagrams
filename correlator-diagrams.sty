    \vertex (corrBoxBR) at (\corr@boxxspan,-\corr@boxyspan);
    \vertex (corrBoxBL) at (-\corr@boxxspan,-\corr@boxyspan);
    \vertex (corrExtUL) at (-\corr@boxexternalxspan,\corr@boxexternalyspan);
    \vertex (corrExtLL) at (-\corr@boxexternalxspan,-\corr@boxexternalyspan);
    \vertex (corrExtLR) at (\corr@boxexternalxspan,-\corr@boxexternalyspan);
    \vertex (corrExtUR) at (\corr@boxexternalxspan,\corr@boxexternalyspan);
    \corr@ifexternallegs{%
      \corr@drawboxexternalprop{1}{corrExtUL}{corrBoxTL}%
      \corr@drawboxexternalprop{2}{corrExtLL}{corrBoxBL}%
      \corr@drawboxexternalprop{3}{corrExtLR}{corrBoxBR}%
      \corr@drawboxexternalprop{4}{corrExtUR}{corrBoxTR}%
    }%
    \corr@drawboxinternalprop{5}{\corr@boxleftline}{corrBoxBL}{corrBoxTL}%
    \corr@drawboxinternalprop{6}{\corr@boxtopline}{corrBoxTL}{corrBoxTR}%
    \corr@drawboxinternalprop{7}{\corr@boxrightline}{corrBoxTR}{corrBoxBR}%
    \corr@drawboxinternalprop{8}{\corr@boxbottomline}{corrBoxBL}{corrBoxBR}%
  \end{feynhand}
  \ifcorr@centervertex
    \corr@putvertex{corrBoxTL}{\corr@centervertexstyle}%
    \corr@putvertex{corrBoxTR}{\corr@centervertexstyle}%
    \corr@putvertex{corrBoxBR}{\corr@centervertexstyle}%
    \corr@putvertex{corrBoxBL}{\corr@centervertexstyle}%
  \fi
  \corr@boxplaceexternalvertices
  \ifcorr@showmomenta
    \corr@drawboxexternalmomentumul{1}{corrExtUL}{corrBoxTL}
    \corr@drawboxexternalmomentumll{2}{corrExtLL}{corrBoxBL}
    \corr@drawboxexternalmomentumlr{3}{corrExtLR}{corrBoxBR}
    \corr@drawboxexternalmomentumur{4}{corrExtUR}{corrBoxTR}
    \corr@drawboxmomentumedge{left}{5}{corrBoxBL}{corrBoxTL}
    \corr@drawboxmomentumedge{top}{6}{corrBoxTL}{corrBoxTR}
    \corr@drawboxmomentumedge{right}{7}{corrBoxTR}{corrBoxBR}
    \corr@drawboxmomentumedge{bottom}{8}{corrBoxBL}{corrBoxBR}
    \corr@drawboxloopmomentum
  \fi
  \corr@drawboxedgelabel{left}{corrBoxBL}{corrBoxTL}
  \corr@drawboxedgelabel{top}{corrBoxTL}{corrBoxTR}
  \corr@drawboxedgelabel{right}{corrBoxTR}{corrBoxBR}
  \corr@drawboxedgelabel{bottom}{corrBoxBL}{corrBoxBR}
