\newcommand{\corr@resolvesunsetlabelshifts}{%
  \pgfmathsetlengthmacro{\corr@sunsettoplabelyshiftresolved}{\corr@sunsettoplabelyshift}%
  \pgfmathsetlengthmacro{\corr@sunsetmiddlelabelyshiftresolved}{\corr@sunsetmiddlelabelyshift}%
  \pgfmathsetlengthmacro{\corr@sunsetbottomlabelyshiftresolved}{\corr@sunsetbottomlabelyshift}%
  \corr@sunsetmarklinehasindices{\corr@sunsettopleftindex}{\corr@sunsettoppropindex}{\corr@sunsettoprightindex}{\corr@sunsettophasindices}%
  \corr@sunsetmarklinehasindices{\corr@sunsetmiddleleftindex}{\corr@sunsetmiddlepropindex}{\corr@sunsetmiddlerightindex}{\corr@sunsetmiddlehasindices}%
  \corr@sunsetmarklinehasindices{\corr@sunsetbottomleftindex}{\corr@sunsetbottompropindex}{\corr@sunsetbottomrightindex}{\corr@sunsetbottomhasindices}%
  \ifcorr@sunsetindexawaremomenta
    \ifnum\corr@sunsettophasindices=1\relax
      \pgfmathsetlengthmacro{\corr@sunsettoplabelyshiftresolved}{\corr@sunsettoplabelyshift + \corr@sunsettoplabelindexclearance}%
    \fi
    \ifnum\corr@sunsettophasindices=1\relax
      \ifdim\corr@sunsetmiddlearrowyshift<0pt
        \pgfmathsetlengthmacro{\corr@sunsetmiddlelabelyshiftresolved}{\corr@sunsetmiddlelabelyshift - \corr@sunsetmiddlelabelindexclearance}%
      \else
        \pgfmathsetlengthmacro{\corr@sunsetmiddlelabelyshiftresolved}{\corr@sunsetmiddlelabelyshift + \corr@sunsetmiddlelabelindexclearance}%
      \fi
    \else
      \ifnum\corr@sunsetmiddlehasindices=1\relax
        \ifdim\corr@sunsetmiddlearrowyshift<0pt
          \pgfmathsetlengthmacro{\corr@sunsetmiddlelabelyshiftresolved}{\corr@sunsetmiddlelabelyshift - \corr@sunsetmiddlelabelindexclearance}%
        \else
          \pgfmathsetlengthmacro{\corr@sunsetmiddlelabelyshiftresolved}{\corr@sunsetmiddlelabelyshift + \corr@sunsetmiddlelabelindexclearance}%
        \fi
      \fi
    \fi
    \ifnum\corr@sunsetbottomhasindices=1\relax
      \pgfmathsetlengthmacro{\corr@sunsetbottomlabelyshiftresolved}{\corr@sunsetbottomlabelyshift - \corr@sunsetbottomlabelindexclearance}%
    \fi
  \fi
}

