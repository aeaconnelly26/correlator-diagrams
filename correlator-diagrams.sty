\NewDocumentCommand{\TwoPointCorr}{O{}}{%
  \begingroup
  \pgfqkeys{/corrdiag}{#1}%
  \corr@preparelists
  \corr@configurestyles
  \begin{tikzpicture}[baseline=-0.6ex,scale=\corr@scale]
    \begin{feynhand}
      \vertex (corrC) at (0,0);
      \vertex (corrL) at (-1.85,0);
      \vertex (corrR) at (1.85,0);
      \corr@drawprop{mom}{1}{corrL}{corrC}
      \corr@drawprop{mom'}{2}{corrR}{corrC}
      \ifcorr@blob
        \corr@putblob{corrC}{\corr@blobstyle}
      \fi
    \end{feynhand}
    \ifcorr@centervertex
      \corr@putvertex{corrC}{\corr@centervertexstyle}
    \fi
    \ifcorr@externalvertices
      \corr@putvertex{corrL}{\corr@externalvertexstyle}
      \corr@putvertex{corrR}{\corr@externalvertexstyle}
    \fi
    \ifcorr@showmomenta
      \corr@drawmomentum{1}{corrL}{corrC}{90}
      \corr@drawmomentum{2}{corrR}{corrC}{-90}
    \fi
    \corr@putlabel{corrL}{xshift=-10pt}{1}
    \corr@putlabel{corrR}{xshift=10pt}{2}
    \corr@putcentral{corrC}
  \end{tikzpicture}%
  \endgroup
}

\NewDocumentCommand{\FourPointCorr}{O{}}{%
  \begingroup
  \pgfqkeys{/corrdiag}{#1}%
  \corr@preparelists
  \corr@configurestyles
  \begin{tikzpicture}[baseline=-0.6ex,scale=\corr@scale]
    \begin{feynhand}
      \vertex (corrC) at (0,0);
      \vertex (corrUL) at (-1.95,1.35);
      \vertex (corrLL) at (-1.95,-1.35);
      \vertex (corrUR) at (1.95,1.35);
      \vertex (corrLR) at (1.95,-1.35);
      \corr@drawprop{mom}{1}{corrUL}{corrC}
      \corr@drawprop{mom'}{2}{corrLL}{corrC}
      \corr@drawprop{mom'}{3}{corrUR}{corrC}
      \corr@drawprop{mom}{4}{corrLR}{corrC}
      \ifcorr@blob
        \corr@putblob{corrC}{\corr@blobstyle}
      \fi
    \end{feynhand}
    \ifcorr@centervertex
      \corr@putvertex{corrC}{\corr@centervertexstyle}
    \fi
    \ifcorr@externalvertices
      \corr@putvertex{corrUL}{\corr@externalvertexstyle}
      \corr@putvertex{corrLL}{\corr@externalvertexstyle}
      \corr@putvertex{corrUR}{\corr@externalvertexstyle}
      \corr@putvertex{corrLR}{\corr@externalvertexstyle}
    \fi
    \ifcorr@showmomenta
      \corr@drawmomentum{1}{corrUL}{corrC}{90}
      \corr@drawmomentum{2}{corrLL}{corrC}{-90}
      \corr@drawmomentum{3}{corrUR}{corrC}{-90}
      \corr@drawmomentum{4}{corrLR}{corrC}{90}
    \fi
    \corr@putlabel{corrUL}{xshift=-11pt,yshift=8pt}{1}
    \corr@putlabel{corrLL}{xshift=-11pt,yshift=-8pt}{2}
    \corr@putlabel{corrUR}{xshift=11pt,yshift=8pt}{3}
    \corr@putlabel{corrLR}{xshift=11pt,yshift=-8pt}{4}
    \corr@putcentral{corrC}
  \end{tikzpicture}%
  \endgroup
}

\NewDocumentCommand{\SunsetDiagram}{O{}}{%
  \begingroup
  \corr@resetsunsetdefaults
  \pgfqkeys{/corrdiag}{#1}%
  \corr@preparelists
  \corr@configurestyles
  \corr@resolvesunsetlabelshifts
  \ifdefempty{\corr@central}{%
    \edef\corr@central{\corr@sunsetcentrallabel}%
  }{}%
  \begin{tikzpicture}[baseline=-0.6ex,scale=\corr@scale]
    \pgfmathsetmacro{\corr@sunsetleftvertexx}{-\corr@sunsetinnerspan}
    \pgfmathsetmacro{\corr@sunsetrightvertexx}{\corr@sunsetinnerspan}
    \pgfmathsetmacro{\corr@sunsetleftextx}{-(\corr@sunsetinnerspan+\corr@sunsetouterspan)}
    \pgfmathsetmacro{\corr@sunsetrightextx}{\corr@sunsetinnerspan+\corr@sunsetouterspan}
    \begin{feynhand}
      \vertex (sunLext) at (\corr@sunsetleftextx,0);
      \vertex (sunLv) at (\corr@sunsetleftvertexx,0);
