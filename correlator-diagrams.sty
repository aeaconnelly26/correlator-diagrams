\newcommand{\corr@preparelists}{%
  \def\corr@legstyleitemslen{0}%
  \def\corr@momitemslen{0}%
  \def\corr@momarrowsizeitemslen{0}%
  \def\corr@proparrowsizeitemslen{0}%
  \def\corr@indexitemslen{0}%
  \def\corr@legitemslen{0}%
  \ifdefempty{\corr@legstyles}{}{%
    \readlist*\corr@legstyleitems{\corr@legstyles}%
  }%
  \ifdefempty{\corr@momentumlabels}{}{%
    \readlist*\corr@momitems{\corr@momentumlabels}%
  }%
  \ifdefempty{\corr@momentumarrowsizes}{}{%
    \readlist*\corr@momarrowsizeitems{\corr@momentumarrowsizes}%
  }%
  \ifdefempty{\corr@propagatorarrowsizes}{}{%
    \readlist*\corr@proparrowsizeitems{\corr@propagatorarrowsizes}%
  }%
  \ifdefempty{\corr@indices}{}{%
    \readlist*\corr@indexitems{\corr@indices}%
  }%
  \ifdefempty{\corr@leglabels}{}{%
    \readlist*\corr@legitems{\corr@leglabels}%
  }%
}

\newcommand{\corr@indexsuffix}[1]{%
  \ifstrequal{\corr@indexplacement}{sup}{^{#1}}{%
    \ifstrequal{\corr@indexplacement}{none}{#1}{_{#1}}%
  }%
}

\newcommand{\corr@fieldwithindex}[1]{%
  \ifnum\corr@indexitemslen<#1
    \corr@field
  \else
    \ifdefempty{\corr@field}{%
      \corr@indexitems[#1]%
    }{%
      \corr@field\corr@indexsuffix{\corr@indexitems[#1]}%
    }%
  \fi
}

\newcommand{\corr@leglabel}[1]{%
  \ifnum\corr@legitemslen<#1
    \corr@fieldwithindex{#1}%
  \else
    \corr@legitems[#1]%
  \fi
}

\newcommand{\corr@momentumlabel}[1]{%
  \ifnum\corr@momitemslen<#1
    \corr@mode_{\number\numexpr\corr@momentumstart+#1-1\relax}%
  \else
    \corr@momitems[#1]%
  \fi
}

\newcommand{\corr@legstylefor}[1]{%
  \ifnum\corr@legstyleitemslen<#1
    \corr@line
  \else
    \corr@legstyleitems[#1]%
  \fi
}

\newcommand{\corr@appendproparrowsize}[1]{%
  \ifnum\corr@proparrowsizeitemslen<#1
    \ifdefempty{\corr@propagatorarrowsize}{}{%
      \edef\corr@propoptions{\corr@propoptions,arrow size=\corr@propagatorarrowsize}%
    }%
  \else
    \edef\corr@thisproparrowsize{\corr@proparrowsizeitems[#1]}%
    \edef\corr@propoptions{\corr@propoptions,arrow size=\corr@thisproparrowsize}%
  \fi
}

\newcommand{\corr@momentumarrowsizefor}[1]{%
  \ifnum\corr@momarrowsizeitemslen<#1
    \corr@momentumarrowsize
  \else
    \corr@momarrowsizeitems[#1]%
  \fi
}

\newcommand{\corr@drawprop}[4]{%
  \edef\corr@propoptions{\corr@legstylefor{#2}}%
  \corr@appendproparrowsize{#2}%
  \expandafter\propag\expandafter[\corr@propoptions] (#3) to (#4);
}

\newcommand{\corr@drawmomentum}[4]{%
  \edef\corr@thismomarrowsize{\corr@momentumarrowsizefor{#1}}%
  \draw[-{Stealth[length=\corr@thismomarrowsize]},line width=0.8pt]
    ($(#2)!0.22!(#3)!6pt!#4:(#3)$) --
    ($(#2)!0.78!(#3)!6pt!#4:(#3)$)
    node[midway,fill=white,inner sep=1pt] {$\corr@momentumlabel{#1}$};
}

\newcommand{\corr@putlabel}[3]{%
  \node at ([#2]#1) {$\corr@leglabel{#3}$};
}

\newcommand{\corr@vertex@dot}[1]{%
  \filldraw[draw=black,fill=black] (#1) circle[radius=2.15pt];
}

\newcommand{\corr@vertex@ringdot}[1]{%
  \draw[line width=0.6pt,fill=white] (#1) circle[radius=2.5pt];
  \filldraw[draw=black,fill=black] (#1) circle[radius=1.05pt];
}

\newcommand{\corr@putvertex}[2]{%
  \edef\corr@vertexstyle{#2}%
  \ifcsdef{corr@vertex@\corr@vertexstyle}{%
    \csname corr@vertex@\corr@vertexstyle\endcsname{#1}%
  }{%
    \begin{feynhand}
      \vertex[\corr@vertexstyle] at (#1);
    \end{feynhand}
  }%
}

\newcommand{\corr@putblob}[2]{%
  \vertex[#2] at (#1);
}

\newcommand{\corr@putcentral}[1]{%
  \ifdefempty{\corr@central}{}{%
    \node[anchor=north] at ([yshift=-9pt]#1) {$\corr@central$};
  }%
}

\newcommand{\corr@putsunsetcentral}[1]{%
  \ifdefempty{\corr@central}{}{%
    \node[anchor=north] at ([yshift=\corr@sunsetcentrallabelyshift]#1) {$\corr@central$};
  }%
}

\newcommand{\corr@sunsetrightmomentumresolved}{%
  \ifdefempty{\corr@sunsetrightmomentum}{%
    \corr@sunsetleftmomentum
  }{%
    \corr@sunsetrightmomentum
  }%
}

\newcommand{\corr@sunsetmomentumlabel}[1]{%
  \ifnum\corr@momitemslen<#1
    \ifcase#1\relax
    \or \corr@sunsetleftmomentum
    \or \corr@sunsetrightmomentumresolved
    \or \corr@sunsettopmomentum
    \or \corr@sunsetmiddlemomentum
    \or \corr@sunsetbottommomentum
    \fi
  \else
    \corr@momitems[#1]%
  \fi
}

\newcommand{\corr@setsunsetpropoptions}[2]{%
  \edef\corr@sunsetsegmentstyle{#2}%
  \ifdefempty{\corr@sunsetsegmentstyle}{%
    \edef\corr@propoptions{\corr@line}%
  }{%
    \edef\corr@propoptions{\corr@sunsetsegmentstyle}%
