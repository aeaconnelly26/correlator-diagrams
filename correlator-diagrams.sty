\newcommand{\corr@drawloopchannelmomentumslot}[5]{%
  \corr@resolveloopchannelmomentumslot{#1}%
  \corr@ifstringeq{\corr@loopchannelmomdir}{none}{}{%
    \edef\corr@thismomarrowsize{\corr@momentumarrowsizefor{#2}}%
    \pgfmathsetmacro{\corr@loopchannelmomstep}{(\corr@loopchannelmomend-\corr@loopchannelmomstart)/8}%
    \pgfmathsetmacro{\corr@loopchannelmompone}{\corr@loopchannelmomstart+\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmomptwo}{\corr@loopchannelmomstart+2*\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmompthree}{\corr@loopchannelmomstart+3*\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmompfour}{\corr@loopchannelmomstart+4*\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmompfive}{\corr@loopchannelmomstart+5*\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmompsix}{\corr@loopchannelmomstart+6*\corr@loopchannelmomstep}%
    \pgfmathsetmacro{\corr@loopchannelmompseven}{\corr@loopchannelmomstart+7*\corr@loopchannelmomstep}%
    \path
      ([xshift=\corr@loopchannelmomxshift,yshift=\corr@loopchannelmomyshift]#3)
      to [#5]
      coordinate[pos=\corr@loopchannelmomstart] (corrloopmomstart)
      coordinate[pos=\corr@loopchannelmompone] (corrloopmompone)
      coordinate[pos=\corr@loopchannelmomptwo] (corrloopmomptwo)
      coordinate[pos=\corr@loopchannelmompthree] (corrloopmompthree)
      coordinate[pos=\corr@loopchannelmompfour] (corrloopmompfour)
      coordinate[pos=\corr@loopchannelmompfive] (corrloopmompfive)
      coordinate[pos=\corr@loopchannelmompsix] (corrloopmompsix)
      coordinate[pos=\corr@loopchannelmompseven] (corrloopmompseven)
      coordinate[pos=\corr@loopchannelmomlabelfraction] (corrmomentumlabelcoord)
      coordinate[pos=\corr@loopchannelmomend] (corrloopmomend)
      ([xshift=\corr@loopchannelmomxshift,yshift=\corr@loopchannelmomyshift]#4);
    \corr@ifstringeq{\corr@loopchannelmomdir}{reverse}{%
      \draw[-{Stealth[length=\corr@thismomarrowsize]},line width=\corr@momentumlinewidth,line cap=round,line join=round]
        (corrloopmomend) --
        (corrloopmompseven) --
        (corrloopmompsix) --
        (corrloopmompfive) --
        (corrloopmompfour) --
        (corrloopmompthree) --
        (corrloopmomptwo) --
        (corrloopmompone) --
        (corrloopmomstart);%
    }{%
      \draw[-{Stealth[length=\corr@thismomarrowsize]},line width=\corr@momentumlinewidth,line cap=round,line join=round]
        (corrloopmomstart) --
        (corrloopmompone) --
        (corrloopmomptwo) --
        (corrloopmompthree) --
        (corrloopmompfour) --
        (corrloopmompfive) --
        (corrloopmompsix) --
        (corrloopmompseven) --
        (corrloopmomend);%
    }%
    \corr@putmomentumlabelwithdistance
      {(corrmomentumlabelcoord)}
      {\corr@loopchannelmomlabelposition}
      {\corr@loopchannelmomlabeldistance}
      {\corr@loopchannelmomlabelxshift}
      {\corr@loopchannelmomlabelyshift}
      {\corr@loopchannelmomlabel}%
  }%
}

