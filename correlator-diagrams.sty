      },
    },
    /tikz/postaction={
      /tikz/decorate=true,
    },
  },
  with white open arrow/.style={
    /tikz/decoration={
      markings,
      mark=at position #1 with {
        \node[
          transform shape,
          xshift=-0.08\feynhandarrowsize,
