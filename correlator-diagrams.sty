\newcommand{\corr@drawfourpointuloopchannel}{%
  \pgfmathsetmacro{\corr@uloopcrossx}{0.74*\corr@fourpointxspan}%
  \pgfmathsetmacro{\corr@uloopflatx}{0.46*\corr@uloopcrossx}%
  \pgfmathsetmacro{\corr@uloopinnerctrlx}{0.84*\corr@uloopcrossx}%
  \pgfmathsetmacro{\corr@ulooptangentback}{0.10}%
  \begin{feynhand}
    \vertex (corrC) at (0,0);
    \vertex (corrUL) at (-\corr@fourpointxspan,\corr@fourpointyspan);
    \vertex (corrLL) at (-\corr@fourpointxspan,-\corr@fourpointyspan);
    \vertex (corrUR) at (\corr@fourpointxspan,\corr@fourpointyspan);
    \vertex (corrLR) at (\corr@fourpointxspan,-\corr@fourpointyspan);
    \vertex (corrVT) at (0,\corr@loopchannelvertexyspan);
    \vertex (corrVB) at (0,-\corr@loopchannelvertexyspan);
    \vertex (corrX) at (\corr@uloopcrossx,0);
    \vertex (corrP4Flat) at (\corr@uloopflatx,\corr@loopchannelvertexyspan);
    \vertex (corrP3Flat) at (\corr@uloopflatx,-\corr@loopchannelvertexyspan);
    \vertex (corrP4CtrlA) at (\corr@uloopinnerctrlx,\corr@loopchannelvertexyspan);
    \vertex (corrP3CtrlA) at (\corr@uloopinnerctrlx,-\corr@loopchannelvertexyspan);
    \path ($(corrX)!-\corr@ulooptangentback!(corrLR)$) coordinate (corrP4CtrlB);
    \path ($(corrX)!-\corr@ulooptangentback!(corrUR)$) coordinate (corrP3CtrlB);
    \corr@ifexternallegs{%
      \corr@drawprop{mom}{1}{corrUL}{corrVT}%
      \corr@drawprop{mom'}{2}{corrLL}{corrVB}%
      \edef\corr@propoptions{\corr@legstylefor{4}}%
      \corr@appendproparrowsize{4}%
      \corr@appendpropcolor
      \expandafter\draw\expandafter[\corr@propoptions]
        (corrVT) -- (corrP4Flat) .. controls (corrP4CtrlA) and (corrP4CtrlB) .. (corrX) -- (corrLR);%
      \edef\corr@propoptions{\corr@legstylefor{3}}%
      \corr@appendproparrowsize{3}%
      \corr@appendpropcolor
      \expandafter\draw\expandafter[\corr@propoptions]
        (corrVB) -- (corrP3Flat) .. controls (corrP3CtrlA) and (corrP3CtrlB) .. (corrX) -- (corrUR);%
    }%
    \corr@drawsunsetprop{5}{\corr@loopchannelaline}{corrVT}{corrVB}{half left,looseness=\corr@loopchannellooplooseness}
    \corr@drawsunsetprop{6}{\corr@loopchannelbline}{corrVT}{corrVB}{half right,looseness=\corr@loopchannellooplooseness}
  \end{feynhand}
  \ifcorr@centervertex
    \corr@putvertex{corrVT}{\corr@centervertexstyle}
    \corr@putvertex{corrVB}{\corr@centervertexstyle}
  \fi
  \corr@fourpointplaceexternalvertices
  \ifcorr@showmomenta
    \corr@drawexternalmomentumul{1}{corrUL}{corrVT}
    \corr@drawexternalmomentumll{2}{corrLL}{corrVB}
    \corr@drawexternalmomentumur{3}{corrUR}{corrX}
    \corr@drawexternalmomentumlr{4}{corrLR}{corrX}
    \corr@drawloopchannelmomentumslot{a}{5}{corrVT}{corrVB}
      {out=180,in=180,looseness=\corr@loopchannelaarrowlooseness}%
    \corr@drawloopchannelmomentumslot{b}{6}{corrVT}{corrVB}
      {out=0,in=0,looseness=\corr@loopchannelbarrowlooseness}%
  \fi
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=180,in=180,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelastartslotpos}{\corr@loopchannelastartindexposition}{\corr@loopchannelastartindexxshift}{\corr@loopchannelastartindexyshift}{\corr@loopchannelastartindex}{\corr@loopchannelvertexindexmathstyle}
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=180,in=180,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelapropslotpos}{\corr@loopchannelainternalindexposition}{\corr@loopchannelainternalindexxshift}{\corr@loopchannelainternalindexyshift}{\corr@loopchannelapropindex}{\corr@loopchannelpropagatorindexmathstyle}
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=180,in=180,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelaendslotpos}{\corr@loopchannelaendindexposition}{\corr@loopchannelaendindexxshift}{\corr@loopchannelaendindexyshift}{\corr@loopchannelaendindex}{\corr@loopchannelvertexindexmathstyle}
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=0,in=0,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelbstartslotpos}{\corr@loopchannelbstartindexposition}{\corr@loopchannelbstartindexxshift}{\corr@loopchannelbstartindexyshift}{\corr@loopchannelbstartindex}{\corr@loopchannelvertexindexmathstyle}
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=0,in=0,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelbpropslotpos}{\corr@loopchannelbinternalindexposition}{\corr@loopchannelbinternalindexxshift}{\corr@loopchannelbinternalindexyshift}{\corr@loopchannelbpropindex}{\corr@loopchannelpropagatorindexmathstyle}
  \corr@putloopchannelinternalindexcurve
    {(corrVT)}{out=0,in=0,looseness=\corr@loopchannellooplooseness}{(corrVB)}
    {\corr@loopchannelbendslotpos}{\corr@loopchannelbendindexposition}{\corr@loopchannelbendindexxshift}{\corr@loopchannelbendindexyshift}{\corr@loopchannelbendindex}{\corr@loopchannelvertexindexmathstyle}
  \corr@fourpointplaceexternallabels
  \corr@putloopchannelcentral{corrC}
}

